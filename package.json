{
  "name": "enma-language",
  "displayName": "Enma Language",
  "description": "Syntax highlighting, snippets, hover docs, completion, signature help, and full LSP services for the Enma scripting language (.em).",
  "version": "1.1.20",
  "publisher": "sin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sin/enma-lsp"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./client/dist/extension.js",
  "bin": {
    "enma-language-server": "./bin/enma-language-server.js"
  },
  "activationEvents": [
    "onLanguage:enma",
    "onLanguage:enma-predefined",
    "onCommand:enma.bundle",
    "onCommand:enma.bundleStripped",
    "onCommand:enma.bundleProject",
    "onCommand:enma.bundleAll",
    "onCommand:enma.initProject",
    "onCommand:enma.openDocs",
    "onCommand:enma.runScript",
    "onCommand:enma.template.scaffold",
    "onCommand:enma.template.ci",
    "onCommand:enma.predefined.edit",
    "onCommand:enma.snapshot.diff",
    "onCommand:enma.aob.explore",
    "onCommand:enma.zydis.playground",
    "onCommand:enma.unicorn.panel",
    "onDebug",
    "onDebugResolve:enma-lsp-dap"
  ],
  "keywords": [
    "enma",
    "scripting",
    "lsp",
    "language-server"
  ],
  "workspaces": [
    "client",
    "server"
  ],
  "contributes": {
    "languages": [
      {
        "id": "enma",
        "aliases": [
          "Enma",
          "enma"
        ],
        "extensions": [
          ".em"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "enma-predefined",
        "aliases": [
          "Enma Predefined"
        ],
        "extensions": [
          ".em.predefined"
        ],
        "filenames": [
          "em.predefined"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "enma-binary",
        "aliases": [
          "Enma Binary"
        ],
        "extensions": [
          ".emb"
        ]
      }
    ],
    "grammars": [
      {
        "language": "enma",
        "scopeName": "source.enma",
        "path": "./syntaxes/enma.tmLanguage.json"
      },
      {
        "language": "enma-predefined",
        "scopeName": "source.enma",
        "path": "./syntaxes/enma.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "enma",
        "path": "./snippets/enma.code-snippets"
      },
      {
        "language": "enma",
        "path": "./snippets/stdlib.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "enma.bundle",
        "title": "Bundle current project",
        "category": "Enma"
      },
      {
        "command": "enma.bundleStripped",
        "title": "Bundle current project (strip comments)",
        "category": "Enma"
      },
      {
        "command": "enma.bundleProject",
        "title": "Bundle a configured project",
        "category": "Enma"
      },
      {
        "command": "enma.bundleAll",
        "title": "Bundle all configured projects",
        "category": "Enma"
      },
      {
        "command": "enma.initProject",
        "title": "Initialize Enma project (source + tasks.json)",
        "category": "Enma"
      },
      {
        "command": "enma.openDocs",
        "title": "Open Perception API Docs",
        "category": "Enma"
      },
      {
        "command": "enma.runScript",
        "title": "Run Script (MCP)",
        "category": "Enma"
      },
      {
        "command": "enma.template.scaffold",
        "title": "Scaffold From Template…",
        "category": "Enma"
      },
      {
        "command": "enma.template.ci",
        "title": "Generate CI Workflow",
        "category": "Enma"
      },
      {
        "command": "enma.predefined.edit",
        "title": "Edit Project em.predefined",
        "category": "Enma"
      },
      {
        "command": "enma.snapshot.diff",
        "title": "Diff Current File With Snapshot…",
        "category": "Enma"
      },
      {
        "command": "enma.aob.explore",
        "title": "AOB Pattern Explorer",
        "category": "Enma"
      },
      {
        "command": "enma.zydis.playground",
        "title": "Zydis Playground",
        "category": "Enma"
      },
      {
        "command": "enma.unicorn.panel",
        "title": "Unicorn Reference Panel",
        "category": "Enma"
      }
    ],
    "keybindings": [
      {
        "command": "enma.bundle",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "resourceExtname == .em"
      },
      {
        "command": "enma.bundleStripped",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "resourceExtname == .em"
      }
    ],
    "taskDefinitions": [
      {
        "type": "enma-bundle",
        "required": [
          "src",
          "out"
        ],
        "properties": {
          "src": {
            "type": "string",
            "description": "Entry .em file (workspace-relative or absolute)."
          },
          "out": {
            "type": "string",
            "description": "Output bundled .em path (workspace-relative or absolute)."
          },
          "strip": {
            "type": "boolean",
            "default": false,
            "description": "Strip line and block comments from the bundled output."
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "enma"
      }
    ],
    "debuggers": [
      {
        "type": "enma-lsp-dap",
        "label": "Enma Debugger (DAP)",
        "languages": [
          "enma"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "address": {
                "type": "string",
                "description": "Host the Enma DAP server is listening on.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "TCP port the Enma DAP server is listening on.",
                "default": 27979
              }
            },
            "required": [
              "address",
              "port"
            ]
          }
        },
        "initialConfigurations": [
          {
            "type": "enma-lsp-dap",
            "request": "attach",
            "name": "Attach to Enma DAP server",
            "address": "localhost",
            "port": 27979
          }
        ],
        "configurationSnippets": [
          {
            "label": "Enma Debug: Attach (localhost:27979)",
            "description": "Attach to a running Enma DAP server",
            "body": {
              "type": "enma-lsp-dap",
              "request": "attach",
              "name": "Attach to Enma DAP server",
              "address": "localhost",
              "port": 27979
            }
          }
        ]
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "variable.other.declaration.enma",
              "variable.other.readwrite.enma"
            ],
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": "variable.other.property.enma",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": [
              "entity.name.type.enma",
              "entity.name.type.template.enma",
              "entity.name.type.class.enma",
              "entity.name.type.struct.enma",
              "entity.name.type.interface.enma",
              "entity.name.type.enum.enma",
              "entity.name.type.delegate.enma",
              "entity.other.inherited-class.enma"
            ],
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "scope": "entity.name.function.enma",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": "entity.name.function.member.enma",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": "support.function.intrinsic.enma",
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": [
              "string.quoted.double.enma",
              "string.quoted.single.enma",
              "string.quoted.double.interpolated.enma"
            ],
            "settings": {
              "foreground": "#D69D85"
            }
          },
          {
            "scope": "entity.name.namespace.enma",
            "settings": {
              "foreground": "#D4D4D4"
            }
          }
        ]
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "variable.global:enma": "#D4D4D4",
          "function.global:enma": "#DCDCAA",
          "namespace.global:enma": "#D4D4D4",
          "class.global:enma": "#4EC9B0",
          "enum.global:enma": "#4EC9B0"
        }
      }
    },
    "configuration": {
      "type": "object",
      "title": "Enma",
      "properties": {
        "enma.indexCache.maxClosedFiles": {
          "type": "number",
          "default": 300,
          "description": "Maximum number of CLOSED files to keep fully indexed in the LRU cache (§A8)."
        },
        "enma.preprocessor.maxIncludeDepth": {
          "type": "number",
          "default": 64,
          "description": "Maximum #include nesting depth before the preprocessor reports an error (§A4)."
        },
        "enma.indexExclude": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            "output",
            "dist",
            "build"
          ],
          "description": "Directory names skipped during workspace .em indexing.",
          "items": {
            "type": "string"
          }
        },
        "enma.implicitMutualInclusion": {
          "type": "boolean",
          "default": false,
          "description": "If true, every .em file in the workspace can see every other .em file without an explicit #include."
        },
        "enma.permissions.ffi": {
          "type": "boolean",
          "default": false,
          "description": "Allow [[dll]] / FFI annotations to bind without a permission error."
        },
        "enma.permissions.file": {
          "type": "boolean",
          "default": false,
          "description": "Allow file-system intrinsics to bind without a permission error."
        },
        "enma.parser.strict": {
          "type": "boolean",
          "default": false,
          "description": "Enable strict parsing — reject all kill-rule recoveries (§A1)."
        },
        "enma.analyzer.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error",
          "description": "Global severity for non-exempt analyzer diagnostics (§R21 rollback knob)."
        },
        "enma.diagnostics.predefinedCollisionSeverity": {
          "type": "string",
          "enum": [
            "warning",
            "information",
            "off"
          ],
          "default": "information",
          "description": "Severity for the diagnostic that fires when a user-defined symbol shadows a bundled predefined symbol (e.g. you define your own url_encode after the stdlib added one). 'warning' (legacy, strict), 'information' (default — visible in Problems but quiet), 'off' (suppress). Per-declaration [[shadow]] always silences regardless."
        },
        "enma.forceIncludePredefined": {
          "type": "array",
          "default": [],
          "description": "Paths to additional .em.predefined files to load with forceInclude precedence (workspace > forceInclude > bundled).",
          "items": {
            "type": "string"
          }
        },
        "enma.predefined.walkUpDepth": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 8,
          "description": "Number of parent directories to scan for .em.predefined files when the workspace root is a subdirectory of a larger project. Set to 0 to disable walk-up discovery."
        },
        "enma.formatter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Enma document formatter. Set to false if AC-11 idempotency fails (v1.0.1 graduation criterion)."
        },
        "enma.formatter.indentSpaces": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces per indent level (when useTabIndent is false)."
        },
        "enma.formatter.useTabIndent": {
          "type": "boolean",
          "default": false,
          "description": "Use a tab character for indentation instead of spaces."
        },
        "enma.formatter.maxBlankLines": {
          "type": "number",
          "default": 1,
          "description": "Maximum number of consecutive blank lines to preserve. Extra blank lines are collapsed."
        },
        "enma.formatter.bracePosition": {
          "type": "string",
          "enum": [
            "sameLine",
            "nextLine"
          ],
          "default": "sameLine",
          "description": "Where to place opening braces: sameLine (K&R style) or nextLine (Allman style)."
        },
        "enma.formatter.spaceAfterComma": {
          "type": "boolean",
          "default": true,
          "description": "Insert a space after commas in argument lists, parameter lists, and initializers."
        },
        "enma.formatter.spaceAroundBinaryOp": {
          "type": "boolean",
          "default": true,
          "description": "Insert spaces around binary operators (+, -, ==, &&, etc.)."
        },
        "enma.formatter.alignDesignatedInit": {
          "type": "boolean",
          "default": false,
          "description": "Align the '=' in designated initializer lists so values start in the same column."
        },
        "enma.formatter.fStringPreserveVerbatim": {
          "type": "boolean",
          "default": true,
          "description": "Preserve f-string byte content verbatim (no whitespace insertion inside interpolations). Disabling may allow internal mutation — not recommended."
        },
        "enma.bundler.sourceDirectory": {
          "type": "string",
          "default": "source",
          "description": "Workspace-relative directory of .em sources to bundle. Every .em file under this directory ships; #include directives only affect ordering."
        },
        "enma.bundler.outputFile": {
          "type": "string",
          "default": "output/bundled.em",
          "description": "Workspace-relative path to write the bundled .em file."
        },
        "enma.bundler.stripComments": {
          "type": "boolean",
          "default": true,
          "description": "Strip line and block comments from the bundled output."
        },
        "enma.bundler.bundleOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Re-run the bundler ~750ms after any .em save. Debounced — multiple rapid saves collapse into a single bundler invocation. Uses `enma.bundler.*` settings when `enma.projects` is empty, or the first entry in `enma.projects` otherwise."
        },
        "enma.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Talk to a Perception engine MCP server (https://docs.perception.cx/perception/enma/mcp-api). Required for engine-side validation (on-save script/validate) and `Enma: Run Script (MCP)`."
        },
        "enma.mcp.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:9077/mcp",
          "description": "URL of the engine MCP server. HTTP/1.1 streamable JSON-RPC."
        },
        "enma.mcp.timeoutMs": {
          "type": "number",
          "default": 5000,
          "description": "Per-call timeout (in milliseconds) for MCP requests. Increase when validating large bundled scripts."
        },
        "enma.mcp.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token sent as `Authorization: Bearer …` on every MCP request."
        },
        "enma.projects": {
          "type": "array",
          "default": [],
          "description": "Define multiple Enma projects within a single workspace. Each project has its own source directory and output file.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sourceDirectory",
              "outputFile"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for this project."
              },
              "sourceDirectory": {
                "type": "string",
                "description": "Source directory for this project's .em files (relative to workspace root)."
              },
              "outputFile": {
                "type": "string",
                "description": "Output file path for the bundled script (relative to workspace root)."
              },
              "stripComments": {
                "type": "boolean",
                "default": false,
                "description": "Whether to strip comments when bundling this project."
              },
              "lspMode": {
                "type": "string",
                "enum": [
                  "full",
                  "syntaxOnly"
                ],
                "default": "full",
                "description": "LSP scope for files under this project. 'full' (default) enables all IntelliSense services. 'syntaxOnly' disables analyzer-driven services (hover, completion, signature help, go-to-def, references, rename, code actions, inlay hints, analyzer diagnostics) — useful for reference folders that should NOT pollute the workspace symbol table."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -b && npm run copy-predefined && node esbuild.config.mjs",
    "watch": "tsc -b -w",
    "lint": "eslint ./client/src ./server/src --ext .ts",
    "test": "cd server && npm test && cd ..",
    "copy-predefined": "node scripts/copy-predefined.mjs",
    "regenerate-stdlib": "node tools/regenerate-stdlib.mjs",
    "validate-predefined": "node tools/validate-predefined.mjs",
    "sync-docs": "node scripts/sync-from-docs-mcp.mjs",
    "build-perception-docs": "node scripts/build-perception-docs.mjs",
    "corpus": "node tools/corpus-fuzz.mjs",
    "package": "vsce package",
    "vscode:prepublish": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json && npm run copy-predefined && npm run build-perception-docs && node scripts/build-prod.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.14.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/debugadapter": "^1.61.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3",
    "vscode-languageclient": "^9.0.1"
  }
}
