# --- Dev/meta directories ---
.vscode/**
.claude/**
.omc/**
**/.omc/**
.github/**
.git/**
.gitignore
.gitattributes

# --- Large unused subtrees ---
spike/**
example/**
docs/**
scripts/**
!scripts/bundler.mjs
tools/**
samples/**

# --- Server sources (only dist/ ships) ---
server/src/**
server/test/**
server/out/**
server/node_modules/**
server/tsconfig.json
server/tsconfig*.json
server/tsconfig.tsbuildinfo
server/.eslintrc*
server/.mocharc*

# --- Client sources (only dist/ ships) ---
client/src/**
client/out/**
client/node_modules/**
client/tsconfig.json
client/tsconfig*.json
client/tsconfig.tsbuildinfo
client/.eslintrc*

# --- Root node_modules and build artifacts ---
node_modules/**
package-lock.json

# --- Source maps + TypeScript sources (defense in depth) ---
**/*.map
**/*.ts

# --- Build configs at root ---
tsconfig.json
tsconfig*.json
esbuild.config.mjs
**/.eslintrc*
**/.mocharc*

# --- Source HTML for the bundled Perception docs (~920 KB).
# Only the stripped output at client/resources/perception-docs.html ships. ---
data/perception-docs.source.html

# --- Packaged extension archives ---
*.vsix
