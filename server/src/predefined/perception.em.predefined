// ============================================================================
// Unicorn API
// https://docs.perception.cx/perception/unicorn-api.md
// mem_read/write + SIMD regs are free functions taking cpu_t.
// ============================================================================

enum uc_reg {
    rax, rbx, rcx, rdx, rsi, rdi, rbp, rsp,
    r8, r9, r10, r11, r12, r13, r14, r15,
    rip, eflags,
    cs, ds, es, fs, gs, ss,
    fs_base, gs_base, mxcsr,
    xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7,
    xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15,
    ymm0, ymm1, ymm2, ymm3, ymm4, ymm5, ymm6, ymm7,
    ymm8, ymm9, ymm10, ymm11, ymm12, ymm13, ymm14, ymm15,
}

enum uc_prot {
    none = 0,
    read = 1,
    write = 2,
    exec = 4,
    rw = 3,
    rx = 5,
    rwx = 7,
    all = 7,
}

enum uc_hook {
    code = 1,
    mem_unmapped = 2,
    mem_read = 3,
    mem_write = 4,
    intr = 5,
}

class cpu_t {
    bool mem_map(int64 addr, int64 size, uc_prot perms);
    bool reg_write64(uc_reg reg, int64 value);
    int64 reg_read64(uc_reg reg);
    int64 start(int64 begin, int64 end, int64 timeout, int64 count);
    void emu_stop();
    bool flush_code();
    bool setup_stack(int64 base, int64 size, int64 stop_addr);
    bool hook_add(uc_hook hook_kind, int64 fn_handle);
    int64 get_last_exception();
    int64 get_exception_address();
}

bool mem_write(cpu_t cpu, int64 addr, const vector& bytes);
vector mem_read(cpu_t cpu, int64 addr, int64 size);
bool reg_write128(cpu_t cpu, uc_reg reg, const vector& bytes);
vector reg_read128(cpu_t cpu, uc_reg reg);
bool reg_write256(cpu_t cpu, uc_reg reg, const vector& bytes);
vector reg_read256(cpu_t cpu, uc_reg reg);

cpu_t cpu_create();
cpu_t cpu_create_process(proc_t proc, bool allow_writes);
cpu_t cpu_active();

