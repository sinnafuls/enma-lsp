// Perception host API declarations for Enma (.em).
// Bundled by enma-lsp — do NOT place a copy in your project unless you intend
// to override symbols (workspace .em.predefined wins over bundled).
//
// Authority (refreshed against docs.perception.cx, 2026-07-28 layout):
//   https://docs.perception.cx/perception/readme.md
//   https://docs.perception.cx/perception/lifecycle-and-routines.md
//   https://docs.perception.cx/perception/proc-api.md
//   https://docs.perception.cx/perception/cpu-api.md
//   https://docs.perception.cx/perception/gui-api.md
//   https://docs.perception.cx/perception/input-api.md
//   https://docs.perception.cx/perception/net-api.md
//   https://docs.perception.cx/perception/render-api.md
//   https://docs.perception.cx/perception/sound-api.md
//   https://docs.perception.cx/perception/unicorn-api.md
//   https://docs.perception.cx/perception/win-api.md
//   https://docs.perception.cx/perception/zydis-api.md
//   https://docs.perception.cx/perception/mcp-api.md
//
// Type spelling in this file:
//   - Bare `string` / `wstring` = language primitives (= std::string / std::wstring
//     under `using namespace std;`). Both const char* and string& overloads are
//     declared where the docs ship them.
//   - Dynamic buffers use `vector<T>` (see enma-std-containers.em.predefined).
//   - Free functions take the handle first when the docs say so (string/vector
//     shapes that type_builder methods cannot own).
//
// Math types (vec2/3/4, quat, mat4) come from enma-stdlib / math-3d — not here.

// ============================================================================
// Lifecycle and routines
// https://docs.perception.cx/perception/lifecycle-and-routines.md
// ============================================================================

// int64 main() — positive return keeps the script loaded; <= 0 unloads after main.

int64 register_routine(int64 fn_handle, int64 data);
bool  unregister_routine(int64 routine_handle);

void heartbeat();
void dbg_print(const char* s);
void dbg_print(const string& s);
void dbg_print_int(int64 x);
void take_int(int64 x);
void take_ptr(int64 p);

// Legacy / example-corpus alias still seen in docs samples.
void print_console(const char* msg);
void print_console(const string& msg);

// ============================================================================
// Proc API
// https://docs.perception.cx/perception/proc-api.md
// proc_t is move-only RAII. No deref(). Addresses are uint64.
// Gates: write_memory | virtual_memory_operations | kernel_rw_access
// ============================================================================

class vad_region_t {
    uint64 start();
    uint64 size();
    uint64 protection();
    bool heap_likely();
}

class module_info_t {
    string name();
    uint64 base();
    uint64 size();
}

class proc_t {
    // Identity
    uint64 base_address();
    uint64 peb();
    uint32 pid();
    bool alive();
    bool is_valid_address(uint64 addr);
    uint64 get_eprocess();                          // gated: kernel_rw_access

    // Read primitives
    uint8  ru8(uint64 addr);
    uint16 ru16(uint64 addr);
    uint32 ru32(uint64 addr);
    uint64 ru64(uint64 addr);
    int8   r8(uint64 addr);
    int16  r16(uint64 addr);
    int32  r32(uint64 addr);
    int64  r64(uint64 addr);
    float32 rf32(uint64 addr);
    float64 rf64(uint64 addr);
    string  rs(uint64 addr, int32 max_chars);
    wstring rws(uint64 addr, int32 max_chars);

    // Write primitives (gated: write_memory)
    bool wu8(uint64 addr, uint8 v);
    bool wu16(uint64 addr, uint16 v);
    bool wu32(uint64 addr, uint32 v);
    bool wu64(uint64 addr, uint64 v);
    bool w8(uint64 addr, int8 v);
    bool w16(uint64 addr, int16 v);
    bool w32(uint64 addr, int32 v);
    bool w64(uint64 addr, int64 v);
    bool wf32(uint64 addr, float32 v);
    bool wf64(uint64 addr, float64 v);
    bool ws(uint64 addr, const char* text);
    bool ws(uint64 addr, const string& text);
    bool wws(uint64 addr, const wstring& text);

    // Bulk r/w — pointer form + vector form
    bool rvm(uint64 addr, void* out, int64 size);
    bool wvm(uint64 addr, void* buf, int64 size);                 // gated: write_memory
    bool wvm(uint64 addr, const vector& bytes);                   // gated: write_memory

    // Typed vector / quaternion / matrix
    vec2 read_vec2_fl32(uint64 addr);
    vec2 read_vec2_fl64(uint64 addr);
    vec3 read_vec3_fl32(uint64 addr);
    vec3 read_vec3_fl64(uint64 addr);
    vec4 read_vec4_fl32(uint64 addr);
    vec4 read_vec4_fl64(uint64 addr);
    quat read_quat_fl32(uint64 addr);
    quat read_quat_fl64(uint64 addr);
    mat4 read_mat4_fl32(uint64 addr);
    mat4 read_mat4_fl64(uint64 addr);

    bool write_vec2_fl32(uint64 addr, vec2 v);
    bool write_vec2_fl64(uint64 addr, vec2 v);
    bool write_vec3_fl32(uint64 addr, vec3 v);
    bool write_vec3_fl64(uint64 addr, vec3 v);
    bool write_vec4_fl32(uint64 addr, vec4 v);
    bool write_vec4_fl64(uint64 addr, vec4 v);
    bool write_quat_fl32(uint64 addr, quat q);
    bool write_quat_fl64(uint64 addr, quat q);
    bool write_mat4_fl32(uint64 addr, mat4 m);
    bool write_mat4_fl64(uint64 addr, mat4 m);

    // Fixed-width SIMD reads (docs: std::array<uint8,N>; LSP uses vector)
    vector r128(uint64 addr);
    vector r256(uint64 addr);
    vector r512(uint64 addr);
    bool w128(uint64 addr, const vector& bytes);
    bool w256(uint64 addr, const vector& bytes);
    bool w512(uint64 addr, const vector& bytes);

    // Modules / exports
    uint64 get_module_base(const char* name);
    uint64 get_module_base(const string& name);
    uint64 get_module_size(const char* name);
    uint64 get_module_size(const string& name);
    vector get_module_list();
    uint64 get_proc_address(uint64 module_base, const char* export_name);
    uint64 get_proc_address(uint64 module_base, const string& export_name);
    uint64 get_import_rdata_address(uint64 module_base, const char* import_name);
    uint64 get_import_rdata_address(uint64 module_base, const string& import_name);

    // Pattern scanning
    uint64 find_code_pattern(uint64 search_start, uint64 search_size, const char* sig);
    uint64 find_code_pattern(uint64 search_start, uint64 search_size, const string& sig);
    vector find_all_code_patterns(uint64 search_start, uint64 search_size, const char* sig);
    vector find_all_code_patterns(uint64 search_start, uint64 search_size, const string& sig);

    // Threads / pointer arrays / VAD
    vector get_all_tebs();
    vector read_pointer_array(uint64 base, int64 count, int64 offset_delta);
    vad_region_t virtual_query(uint64 address);
    vector get_vad_snapshot(bool heap_likely_only);

    // Memory scans
    vector scan_string(const char* text, bool heap_only);
    vector scan_string(const string& text, bool heap_only);
    vector scan_wstring(const char* text, bool heap_only);
    vector scan_wstring(const string& text, bool heap_only);
    vector scan_pointer(uint64 target, bool heap_only);
    vector scan_u64(uint64 value, bool heap_only);
    vector scan_u32(uint32 value, bool heap_only);
    vector scan_float(float32 value, bool heap_only);
    vector scan_double(float64 value, bool heap_only);

    // VM alloc (gated: virtual_memory_operations)
    uint64 alloc_vm(uint64 size);
    bool free_vm(uint64 address);
}

proc_t ref_process(uint32 pid);
proc_t ref_process(const char* name);
proc_t ref_process(const string& name);

// ============================================================================
// CPU API
// https://docs.perception.cx/perception/cpu-api.md
// ============================================================================

string cpu_vendor();
string cpu_brand();

int64 rdtsc();
int64 perf_time();
int64 perf_frequency();
int64 get_tickcount64();

int64  now_millisecond();
string day_name(int64 dow);
string month_name(int64 month);
int64  hour12(int64 hour24);
string ampm(int64 hour24);

// Bit-pattern conversions: reinterpret_cast / std::bit_cast — no bits_* natives.

enum thread_priority {
    lowest,
    below_normal,
    normal,
    above_normal,
    highest,
    time_critical,
}

bool set_thread_priority(thread_priority p);

// ============================================================================
// GUI API
// https://docs.perception.cx/perception/gui-api.md
// Handles are engine-owned int64 wrappers; dtor is noop; unload sweeps.
// Free functions own std::string / std::vector shapes (type_builder limit).
// ============================================================================

enum ui_align { left, center, right }
enum ui_anchor { none, left, right, top, bottom, all }
enum ui_edge { left, top, right, bottom }
enum ui_layout { none, vertical, horizontal }
enum keybind_mode { off, on, single, toggle, always_on }
enum toast_kind { info, success, warning, error }
enum ui_callback { value_changed, item_activated }

enum ui_color {
    bg,
    fg,
    text,
    text_primary,
    text_secondary,
    accent,
    border,
    frame_bg,
    sidebar_bg,
    element_button_bg,
}

