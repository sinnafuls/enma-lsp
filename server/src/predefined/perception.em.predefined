void set(inline_text_input_t w, const char* s);
void set(inline_text_input_t w, const string& s);
void set(text_input_t w, const char* s);
void set(text_input_t w, const string& s);
void set(text_editor_t w, const char* s);
void set(text_editor_t w, const string& s);
void set_items(list_t w, const vector& info1, const vector& info2);
void add_row(table_t w, const vector& cells);

// --- sidebar section ------------------------------------------------------

class sidebar_section_t {
    void set_active(bool active);

    // Scalar-arg builders stay as methods
    label_t             create_label(const char* text, ui_align align);
    label_t             create_label(const string& text, ui_align align);
    void                create_separator();
    button_t            create_button(const char* label, ui_align align);
    button_t            create_button(const string& label, ui_align align);
    checkbox_t          create_checkbox(const char* label, bool initial);
    checkbox_t          create_checkbox(const string& label, bool initial);
    slider_t            create_slider(const char* label, float64 initial, float64 minv, float64 maxv, float64 step);
    slider_t            create_slider(const string& label, float64 initial, float64 minv, float64 maxv, float64 step);
    slider_icon_t       create_slider_icon(const char* icon, float64 initial, float64 minv, float64 maxv, float64 step);
    slider_icon_t       create_slider_icon(const string& icon, float64 initial, float64 minv, float64 maxv, float64 step);
    value_input_t       create_value_input(const char* label, float64 initial, float64 minv, float64 maxv, float64 step);
    value_input_t       create_value_input(const string& label, float64 initial, float64 minv, float64 maxv, float64 step);
    inline_button_t     create_inline_button(const char* label, float64 width, const char* icon);
    inline_button_t     create_inline_button(const string& label, float64 width, const string& icon);
    inline_text_input_t create_inline_text_input(const char* initial, float64 width, const char* placeholder);
    inline_text_input_t create_inline_text_input(const string& initial, float64 width, const string& placeholder);
    keybind_t           create_keybind(const char* label);
    keybind_t           create_keybind(const string& label);
    progress_bar_t      create_progress_bar(const char* label, float64 initial, float64 minv, float64 maxv, bool show_pct);
    progress_bar_t      create_progress_bar(const string& label, float64 initial, float64 minv, float64 maxv, bool show_pct);
    spinner_t           create_spinner(const char* label);
    spinner_t           create_spinner(const string& label);
    range_slider_t      create_range_slider(const char* label, float64 minv, float64 maxv, float64 lo, float64 hi, float64 step);
    range_slider_t      create_range_slider(const string& label, float64 minv, float64 maxv, float64 lo, float64 hi, float64 step);
    text_input_t        create_text_input(const char* label, const char* initial, int64 max_lines);
    text_input_t        create_text_input(const string& label, const string& initial, int64 max_lines);
    text_editor_t       create_text_editor(const char* label, const char* initial, int64 visible_lines, const char* lexer);
    text_editor_t       create_text_editor(const string& label, const string& initial, int64 visible_lines, const string& lexer);
    colorpicker_t       create_colorpicker(const char* label, color initial);
    colorpicker_t       create_colorpicker(const string& label, color initial);
}

// Vector-arg builders are free functions (section first)
options_t        create_options(sidebar_section_t s, const char* label, const vector& items, int64 selected);
options_t        create_options(sidebar_section_t s, const string& label, const vector& items, int64 selected);
multi_options_t  create_multi_options(sidebar_section_t s, const char* label, const vector& items, int64 selected_mask);
multi_options_t  create_multi_options(sidebar_section_t s, const string& label, const vector& items, int64 selected_mask);
dropdown_t       create_dropdown(sidebar_section_t s, const char* label, const vector& items, int64 selected);
dropdown_t       create_dropdown(sidebar_section_t s, const string& label, const vector& items, int64 selected);
multi_dropdown_t create_multi_dropdown(sidebar_section_t s, const char* label, const vector& items, int64 selected_mask);
multi_dropdown_t create_multi_dropdown(sidebar_section_t s, const string& label, const vector& items, int64 selected_mask);
list_t           create_list(sidebar_section_t s, const char* label, const vector& info1, const vector& info2, bool selectable, int64 selected, int64 visible_rows, bool filterable);
list_t           create_list(sidebar_section_t s, const string& label, const vector& info1, const vector& info2, bool selectable, int64 selected, int64 visible_rows, bool filterable);
tabs_t           create_tabs(sidebar_section_t s, const vector& items, int64 selected);
table_t          create_table(sidebar_section_t s, const char* label, const vector& col_names, const vector& col_widths, int64 visible_rows);
table_t          create_table(sidebar_section_t s, const string& label, const vector& col_names, const vector& col_widths, int64 visible_rows);

sidebar_section_t create_sidebar_section(const char* name, const char* icon);
sidebar_section_t create_sidebar_section(const string& name, const string& icon);
void create_sidebar_separator();

// --- frames / layers / widgets / menus / file picker ----------------------

class layer_t {
    void promote_to_top();
    void set_visible(bool v);
    int64 frame_count();
    bool register_in_taskbar(const char* label);
    bool register_in_taskbar(const string& label);
    void unregister_from_taskbar();
}

class frame_t {
    void set_pos(vec2 pos);
    void set_size(vec2 size);
    vec2 get_pos();
    vec2 get_size();
    void set_visible(bool v);
    bool is_visible();
    void set_anchors(int64 mask);
    void attach(frame_t parent);
    void set_float(int64 hash, float64 v);
    void install_hook(int64 hook_id, int64 fn_handle);
    void remove_hook(int64 hook_id);
    void set_focused();
}

class widget_t {
    void set_pos(vec2 pos);
    void set_size(vec2 size);
    void set_active(bool v);
    void set_tooltip(const char* s);
    void set_tooltip(const string& s);
    void set_float(int64 hash, float64 v);
    void set_anchors(int64 mask);
    void install_hook(int64 hook_id, int64 fn_handle);
    void remove_hook(int64 hook_id);
}

frame_t create_frame(const char* name, vec2 pos, vec2 size, layer_t layer);
frame_t create_frame(const string& name, vec2 pos, vec2 size, layer_t layer);
frame_t create_default_frame(const char* name, vec2 pos, vec2 size, layer_t layer);
frame_t create_default_frame(const string& name, vec2 pos, vec2 size, layer_t layer);
frame_t create_draggable_frame(const char* name, vec2 pos, vec2 size, layer_t layer);
frame_t create_draggable_frame(const string& name, vec2 pos, vec2 size, layer_t layer);
frame_t create_popup(const char* name, vec2 pos, vec2 size, layer_t layer);
