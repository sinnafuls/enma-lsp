# Stop CRLF/LF churn on generated and bundled files.
# Generated content is written with LF; locking it here keeps Windows clones
# from re-marking the file as modified on every checkout / regen.

*.em.predefined           text eol=lf
*.em                      text eol=lf
*.json                    text eol=lf
*.mjs                     text eol=lf
*.ts                      text eol=lf
*.tsx                     text eol=lf

# Shell scripts and similar must keep LF regardless of OS.
*.sh                      text eol=lf
bin/enma-language-server  text eol=lf

# Binary or already-handled assets — leave to git's defaults.
*.vsix                    binary
*.pdf                     binary

# ── GitHub Linguist ──────────────────────────────────────────────────
# Generated documentation dumps dominate the byte count and made GitHub
# misclassify the repository as HTML. Exclude them from language stats.
client/resources/perception-docs.html   linguist-generated=true
data/perception-docs.source.html        linguist-generated=true
*.html                                   linguist-detectable=false
# The tree-sitter grammar spike is vendored experimental tooling.
spike/**                                 linguist-vendored=true
# Generated/bundled JSON data and the TextMate grammar are not source.
data/docs-catalogue.json                 linguist-generated=true
data/enma-stdlib.json                    linguist-generated=true
syntaxes/enma.tmLanguage.json            linguist-generated=true
# Treat Enma sources as a first-class (vendored highlight via C++ proxy).
*.em                                     linguist-language=C++ linguist-detectable=true
*.em.predefined                          linguist-language=C++ linguist-detectable=true
